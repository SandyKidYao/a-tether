{
  "name": "@a-tether/pi",
  "version": "0.1.0",
  "description": "Pi extension and launcher that uses a remote Claude Code through an A-tether SSH tunnel.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandyKidYao/a-tether.git",
    "directory": "packages/pi"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "a-tether-pi": "dist/frontends/pi/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/frontends/pi/extension.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
