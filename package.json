{
  "name": "a-tether",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "server": "node --experimental-transform-types src/server.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "test:live": "node --experimental-transform-types tests/live.mjs",
    "build": "node scripts/build.mjs",
    "pack:dry": "npm run build && npm pack --dry-run ./packages/server ./packages/pi"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3"
  },
  "pi": {
    "extensions": [
      "./src/frontends/pi/extension.ts"
    ]
  },
  "license": "MIT"
}
